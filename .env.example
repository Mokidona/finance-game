# Скопируйте в .env (`cp .env.example .env`) — docker compose подхватит его сам.

# Домен для фронтенда в Traefik
DOMAIN=localhost

# Имя certresolver в Traefik
CERTRESOLVER=myresolver

# Общая сеть Traefik
TRAEFIK_NETWORK=traefik-public

# Часовой пояс контейнеров (по нему считается «сегодня» для дневного лимита)
TZ=Asia/Almaty

# Скопируйте в .env (`cp .env.example .env`) — docker compose подхватит его сам.

# Домен, на который сажается фронтенд в Traefik (label Host(`...`)).
DOMAIN=2mln.freeddns.org

# Имя certresolver в статике Traefik на сервере (проверьте секцию certificatesResolvers).
CERTRESOLVER=myresolver

# Имя общей внешней сети Traefik. Проверить на сервере: docker network ls | grep traefik
TRAEFIK_NETWORK=traefik-public

# Часовой пояс контейнеров. По нему считается «сегодня»: дневной лимит, стрик,
# монеты и нокаут питомца (date.today() в services/budget.py). На сервере в
# Казахстане это Asia/Almaty; для Москвы — Europe/Moscow.
TZ=Asia/Almaty

# Токен бота Telegram (получить у @BotFather). Нужен для авторизации Mini App
# (проверка подписи initData) и приема платежей в Telegram Stars.
BOT_TOKEN=

# Секрет вебхука бота: любая случайная строка (например: openssl rand -hex 32).
# Telegram будет присылать её в заголовке X-Telegram-Bot-Api-Secret-Token;
# setWebhook выполняется автоматически при старте контейнера.
WEBHOOK_SECRET=

# Цена премиума в звездах Telegram (XTR). Комиссию Telegram учитывайте сами:
# 50 звезд примерно соответствуют 990 KZT, точное соотношение плавает.
PREMIUM_STARS_PRICE=50

# Пользователи создаются сами при первом заходе из Telegram (по initData).
# Создавать владельца вручную больше не нужно.

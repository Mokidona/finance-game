# Контекст сборки бэкенда — только код и зависимости.
# Дев-база не попадает в образ: на сервере данные живут на volume (DB_PATH=/data/budget.db)
# и при первом старте создаются заново (app/seed.py наполняет демо-профиль).
budget.db
budget.db-wal
budget.db-shm
*.db
*.db-wal
*.db-shm
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
.env.*
*.log
.DS_Store
